# Atlantis Enterprise Configuration - Real Deployment

# GitHub Configuration
ATLANTIS_GH_USER=mmparmar553
ATLANTIS_GH_TOKEN=demo-token-for-testing
ATLANTIS_GH_WEBHOOK_SECRET=atlantis-enterprise-webhook-secret-2024

# Repository Configuration
ATLANTIS_REPO_ALLOWLIST=github.com/mmparmar553/atlantis-production-setup

# Server Configuration
ATLANTIS_URL=http://localhost:4141
ATLANTIS_PORT=4141

# AWS Configuration - Will use environment variables
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_DEFAULT_REGION=us-west-2

# Enterprise Features
ATLANTIS_ENABLE_POLICY_CHECKS=true
ATLANTIS_REQUIRE_APPROVAL=true
ATLANTIS_REQUIRE_MERGEABLE=true
ATLANTIS_LOG_LEVEL=info
