# Atlantis Enterprise Configuration - Real Deployment
# IMPORTANT: This file contains sensitive information - never commit to Git

# GitHub Configuration
ATLANTIS_GH_USER=mmparmar553
ATLANTIS_GH_TOKEN=your-github-token-here
ATLANTIS_GH_WEBHOOK_SECRET=atlantis-enterprise-webhook-secret-2024

# Server Configuration
ATLANTIS_URL=http://localhost:4141

# AWS Configuration - Using environment credentials
AWS_ACCESS_KEY_ID=placeholder-will-use-env
AWS_SECRET_ACCESS_KEY=placeholder-will-use-env
AWS_DEFAULT_REGION=us-west-2

# Enterprise Security Settings
ATLANTIS_ENABLE_POLICY_CHECKS=true
ATLANTIS_REQUIRE_APPROVAL=true
ATLANTIS_REQUIRE_MERGEABLE=true

# Logging and Monitoring
ATLANTIS_LOG_LEVEL=info
ATLANTIS_ENABLE_DIFF_MARKDOWN_FORMAT=true
